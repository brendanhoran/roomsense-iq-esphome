# Copy this file to secrets.yaml and fill in real values.
# secrets.yaml is gitignored so your credentials never get committed.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Password for the fallback setup hotspot (used only if Wi-Fi fails).
ap_password: "change-me-fallback-ap"

# Home Assistant API encryption key (32 bytes, base64).
# Generate one with:  openssl rand -base64 32
api_key: "REPLACE_WITH_openssl_rand_-base64_32"
